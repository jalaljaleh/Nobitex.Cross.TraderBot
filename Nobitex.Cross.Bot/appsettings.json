{
  "Mode": "DryRun",

  "//": "Single-market configuration: GRAM/USDT only. Every number below is configurable.",

  "Markets": {
    "GRAM/USDT": {
      "Enabled": true,

      // Budget of THIS market only. It is never shared with any other market.
      "BudgetUsdt": 20,
      // Percentage of the budget that is deliberately kept unused (0-90).
      "ReservePercent": 5,

      "Symbol": {
        "Base": "GRAM",
        "Quote": "USDT"
      },

      // Exchange trading rules — VERIFY these on the Nobitex GRAM/USDT order form
      // before going live (see the note on the page). Wrong values only cause the
      // order to be rejected, never an over-sized order.
      "MarketRules": {
        "PriceTick": 0.0001,
        "QuantityStep": 0.1,
        "MinQuantity": 1,
        "MinNotional": 11,
        "MaxQuantity": 5000,
        "MaxPriceDeviationPercent": 3
      },

      // Fee rates of your Nobitex tier; FeeAsset = Base means the fee is taken from GRAM.
      "Fee": {
        "MakerRate": 0.001,
        "TakerRate": 0.001,
        "FeeAsset": "Base"
      },

      // Passive buy ladder: 3 steps below the fair price.
      // Sum of AllocationPercent must be <= 100.
      "Ladder": {
        "SpacingModel": "FixedPercent",
        "Steps": [
          {
            "OffsetPercent": 1,
            "AllocationPercent": 25
          },
          {
            "OffsetPercent": 2,
            "AllocationPercent": 50
          },
          {
            "OffsetPercent": 3,
            "AllocationPercent": 25
          }
        ]
      },

      // Exit: net profit target after buy fee + sell fee + slippage.
      // Sum of TakeProfitStages FillPercent must be exactly 100.
      "Exit": {
        "TargetNetProfitPercent": 0.6,
        "SlippageAllowancePercent": 0.15,
        "MaxSlippagePercent": 0.5,
        "EmergencyExit": false,
        "MaxHoldingTime": "04:00:00",
        "TakeProfitStages": [
          {
            "FillPercent": 50,
            "PremiumPercent": 0.4
          },
          {
            "FillPercent": 50,
            "PremiumPercent": 0.9
          }
        ]
      }
    }
  },

  // Reference venue. GRAM/USDT is listed on Binance spot, so the default source works.
  "FairPrice": {
    "ReferenceExchange": "Binance",
    "ReferenceSymbol": "GRAM/USDT",
    "MaxReferenceAge": "00:00:05",
    "LocalBasis": {
      "Mode": "MedianWindow",
      "Window": 600,
      "Override": null,
      "DeviationFreezeSigma": 3
    }
  },

  "Guard": {
    "MaxDropPerSecondPercent": 0.35,
    "MaxVolatilityPercent": 1.2,
    "MaxSpreadWidenFactor": 3,
    "MaxFairPriceJumpPercent": 0.5,
    "Cooldown": "00:00:45"
  },

  "Risk": {
    "MaxInventoryBase": 500,
    "MaxExposureUsdt": 950,
    "MaxDrawdownPercent": 4,
    "MaxHoldingTime": "04:00:00",
    "MaxOpenOrders": 6,
    "MaxOrderSizeUsdt": 500,
    "MaxPriceDeviationPercent": 3,
    "MarketShockThresholdPercent": 2,
    "EmergencyStop": false,
    "MaxConsecutiveFailures": 3
  },

  "Execution": {
    "PollInterval": "00:00:02",
    "RequoteBandPercent": 0.25,
    "RequoteConfirm": "00:00:10",
    "RequoteCooldown": "00:00:30",
    "MakerBufferPercent": 0.05,
    "MaxOrderAge": "02:00:00",
    "CancelAllOnExit": false,
    "DuplicateOrderWindow": "00:00:10"
  },

  "Persistence": {
    "Provider": "Sqlite",
    "DatabasePath": "cross-exchange-bot.db"
  }
}