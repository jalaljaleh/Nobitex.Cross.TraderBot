{
  "Mode": "LiveTrading", //DryRun

  "//": "Single-market configuration: BANK/USDT. Test budget: 1 USDT.",

  "Markets": {
    "BANK/USDT": {
      "Enabled": true,

      "BudgetUsdt": 1,
      "ReservePercent": 5,

      "Symbol": {
        "Base": "BANK",
        "Quote": "USDT"
      },

      "MarketRules": {
        "PriceTick": 0.00001,
        "QuantityStep": 1,
        "MinQuantity": 1,
        "MinNotional": 0.4,
        "MaxQuantity": 100,
        "MaxPriceDeviationPercent": 3
      },

      "Fee": {
        "MakerRate": 0.001,
        "TakerRate": 0.001,
        "FeeAsset": "Base"
      },

      "Ladder": {
        "SpacingModel": "FixedPercent",
        "Steps": [
          {
            "OffsetPercent": 1,
            "AllocationPercent": 100
          }
        ]
      },

      "Exit": {
        "TargetNetProfitPercent": 0.6,
        "SlippageAllowancePercent": 0.15,
        "MaxSlippagePercent": 0.5,
        "EmergencyExit": false,
        "MaxHoldingTime": "04:00:00",
        "TakeProfitStages": [
          {
            "FillPercent": 50,
            "PremiumPercent": 0.4
          },
          {
            "FillPercent": 50,
            "PremiumPercent": 0.9
          }
        ]
      }
    }
  },

  "FairPrice": {
    "ReferenceExchange": "Binance",
    "ReferenceSymbol": "BANK/USDT",
    "MaxReferenceAge": "00:00:05",
    "LocalBasis": {
      "Mode": "MedianWindow",
      "Window": 600,
      "Override": null,
      "DeviationFreezeSigma": 3
    }
  },

  "Guard": {
    "MaxDropPerSecondPercent": 0.35,
    "MaxVolatilityPercent": 2.0,
    "MaxSpreadWidenFactor": 3,
    "MaxFairPriceJumpPercent": 0.5,
    "Cooldown": "00:00:45"
  },

  "Risk": {
    "MaxInventoryBase": 100,
    "MaxExposureUsdt": 0.95,
    "MaxDrawdownPercent": 4,
    "MaxHoldingTime": "04:00:00",
    "MaxOpenOrders": 2,
    "MaxOrderSizeUsdt": 0.95,
    "MaxPriceDeviationPercent": 3,
    "MarketShockThresholdPercent": 2,
    "EmergencyStop": false,
    "MaxConsecutiveFailures": 3
  },

  "Execution": {
    "PollInterval": "00:00:02",
    "RequoteBandPercent": 0.25,
    "RequoteConfirm": "00:00:10",
    "RequoteCooldown": "00:00:30",
    "MakerBufferPercent": 0.05,
    "MaxOrderAge": "00:10:00",
    "CancelAllOnExit": false,
    "DuplicateOrderWindow": "00:00:10"
  },

  "Persistence": {
    "Provider": "Sqlite",
    "DatabasePath": "cross-exchange-bot.db"
  }
}
